<?xml version="1.0" encoding="utf-8"?>
<!-- Braze SDK configuration: add your own keys (do not commit real secrets). -->
<resources>
  <!-- Braze SDK configuration: API Key -->
  <string translatable="false" name="com_braze_api_key">YOUR_BRAZE_API_KEY</string>
  <!-- Braze SDK configuration: Custom Endpoint -->
  <string translatable="false" name="com_braze_custom_endpoint">YOUR_SDK_ENDPOINT_HOST</string>
  <!-- Minimum time interval (in seconds) between in-app message triggers -->
  <!-- Default is 30 seconds. Setting to 5 seconds allows messages to trigger more frequently -->
  <integer name="com_braze_trigger_action_minimum_time_interval_seconds">5</integer>
  <!-- Braze SDK configuration: Firebase Cloud Messaging -->
  <bool translatable="false" name="com_braze_firebase_cloud_messaging_registration_enabled">true</bool>
  <string translatable="false" name="com_braze_firebase_cloud_messaging_sender_id">YOUR_FCM_SENDER_ID</string>
  
  <!-- Braze SDK configuration: Notification icons - using app icon -->
  <drawable name="com_braze_push_small_notification_icon">@mipmap/ic_launcher</drawable>
  <drawable name="com_braze_push_large_notification_icon">@mipmap/ic_launcher</drawable>
  
  <!-- Braze SDK configuration: Default notification channel configuration -->
  <string name="com_braze_default_notification_channel_name">Store Notifications</string>
  <string name="com_braze_default_notification_channel_description">Notifications from the store</string>
  
  <!-- Braze SDK configuration: Enable automatic deep link opening -->
  <bool name="com_braze_handle_push_deep_links_automatically">true</bool>
</resources>
